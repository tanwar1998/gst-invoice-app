# Copy this file to .env in the project root and edit the values.

PORT=4000

# ---------- Seller / global configuration ----------
SELLER_NAME=Your Flour Mills Pvt Ltd
SELLER_ADDRESS=Shop 12, Grain Market, Main Road, Lucknow, Uttar Pradesh - 226001
SELLER_GSTIN=09ABCDE1234F1Z5
SELLER_PHONE=9876543210
SELLER_EMAIL=billing@example.com
SELLER_STATE_NAME=Uttar Pradesh
SELLER_STATE_CODE=09

# State used for intra/inter state comparison (normally same as seller state code)
HOME_STATE_CODE=09
TAX_MODE=AUTO
# TAX_MODE options: AUTO | FORCE_INTRA | FORCE_INTER
ALLOW_PER_INVOICE_OVERRIDE=true
DEFAULT_SALE_CHANNEL=OFFLINE
# Leave blank to use HOME_STATE_CODE; otherwise use a state code like 27
DEFAULT_PLACE_OF_SUPPLY=

# true = product prices already include GST; false = prices are before GST
PRICES_INCLUDE_GST=false

INVOICE_PREFIX=BILL
FY_FORMAT=YYYY-YY
# FY_FORMAT options: YYYY-YY | YY-YY | YYYY-YYYY

ROUNDING=NEAREST_RUPEE
# ROUNDING options: NEAREST_RUPEE | NONE

CURRENCY=INR
CURRENCY_SYMBOL=₹
DATE_FORMAT=DD/MM/YYYY
# DATE_FORMAT options: DD/MM/YYYY | YYYY-MM-DD | DD-MMM-YYYY

# ---------- Bank details shown on the invoice ----------
BANK_NAME=State Bank of India
BANK_ACCOUNT_NUMBER=00000000000
BANK_IFSC=SBIN0000000
BANK_BRANCH=Lucknow Main Branch

TERMS=Goods once sold will not be taken back. Payment due on delivery. Subject to Lucknow jurisdiction.
